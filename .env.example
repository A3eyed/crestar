# Copy these names into Cloudflare secrets / EAS secrets. Do not commit real values.

DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://crestarhq.com
BETTER_AUTH_TRUSTED_ORIGINS=https://crestarhq.com,https://www.crestarhq.com

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=crestar-media
R2_PUBLIC_BASE_URL=https://media.crestarhq.com

# Cloudflare Stream (live shopping) — API token needs Account → Stream → Edit
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Sign in with Apple (preferred: dynamic JWT — no static APPLE_CLIENT_SECRET)
APPLE_CLIENT_ID=                    # Services ID for web (e.g. com.crestar.hq.web)
APPLE_TEAM_ID=                      # 10-char Team ID
APPLE_KEY_ID=                       # 10-char Key ID from the .p8 key
APPLE_PRIVATE_KEY=                  # Full .p8 PEM (use \n for newlines in env)
APPLE_APP_BUNDLE_IDENTIFIER=com.crestar.hq
# APPLE_CLIENT_SECRET=              # optional fallback only; prefer dynamic JWT above

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
