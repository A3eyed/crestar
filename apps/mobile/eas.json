{
  "cli": {
    "version": ">= 15.0.15",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "corepack": true,
      "node": "22.14.0",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "YARN_ENABLE_IMMUTABLE_INSTALLS": "false",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "corepack": true,
      "node": "22.14.0",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "YARN_ENABLE_IMMUTABLE_INSTALLS": "false",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "corepack": true,
      "node": "22.14.0",
