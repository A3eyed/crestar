{
  "cli": {
    "version": ">= 15.0.15",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "corepack": true,
      "node": "20.18.1",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "YARN_ENABLE_IMMUTABLE_INSTALLS": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "corepack": true,
      "node": "20.18.1",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "YARN_ENABLE_IMMUTABLE_INSTALLS": "false"
      }
    },
    "production": {
      "autoIncrement": true,
      "corepack": true,
      "node": "20.18.1",
      "ios": { "resourceClass": "m-medium" },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "YARN_ENABLE_IMMUTABLE_INSTALLS": "false"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "${APPLE_TEAM_ID}",
        "ascAppId": "${ASC_APP_ID}"
      }
    }
  }
}
