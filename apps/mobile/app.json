{
  "expo": {
    "name": "Crestar",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "autolinking": {
      "exclude": [
        "react-native-maps",
        "@shopify/react-native-skia",
        "react-native-graph",
        "@react-native-community/slider",
        "@react-native-picker/picker",
        "react-native-google-mobile-ads"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"],
        "NSCameraUsageDescription": "Crestar uses your camera only when you choose to record a shoppable video, go live, or take a photo for your profile or a product listing.",
        "NSMicrophoneUsageDescription": "Crestar uses your microphone only while you are recording a video or streaming live, so your videos have sound.",
        "NSPhotoLibraryUsageDescription": "Crestar needs access to your photo library so you can pick photos and videos to post, to add to your product listings, or to use as your profile picture.",
        "NSPhotoLibraryAddUsageDescription": "Crestar saves videos and photos you create in the app to your photo library when you ask it to.",
        "NSLocationWhenInUseUsageDescription": "Crestar uses your location only while the app is open: to fill in your delivery address, show restaurants and sellers near you in FoodHub, set up seller delivery zones, and let deliverers share their position while they are viewing an active delivery. Crestar never collects your location in the background or when the app is closed.",
        "CFBundleDisplayName": "Crestar"
      },
      "bundleIdentifier": "com.crestar.hq",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.crestar.hq"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-light.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 220,
            "resizeMode": "contain",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-audio",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "@sentry/react-native/expo",
      [
        "expo-notifications",
        {
          "color": "#D4AF37"
        }
      ],
      "expo-apple-authentication"
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false,
        "sitemap": false
      },
      "eas": {
        "projectId": "b341ed25-1eb0-4fe4-8515-01f12cc4da20"
      }
    },
    "slug": "22eaf7fd-f570-4d68-87e3-8739d6f135f5",
    "scheme": "crestar.22eaf7fd-f570-4d68-87e3-8739d6f135f5"
  }
}
