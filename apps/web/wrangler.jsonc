{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crestar",
  "main": ".open-next/worker.js",
  // After 2025-04-01, nodejs_compat populates process.env from Worker secrets/vars
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "crestar"
    }
  ],
  // Public (non-secret) runtime vars — safe to commit.
  // Secrets must NOT go here. Set them in the dashboard as Secrets, or:
  //   npx wrangler secret put NEON_AUTH_BASE_URL
  //   npx wrangler secret put NEON_AUTH_COOKIE_SECRET
  //   npx wrangler secret put DATABASE_URL
  "vars": {
    "BETTER_AUTH_URL": "https://crestarhq.com",
    "NEXT_PUBLIC_APP_URL": "https://crestarhq.com"
  },
  "observability": {
    "enabled": true
  }
}
